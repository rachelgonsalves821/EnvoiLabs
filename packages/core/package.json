{
  "name": "@envoi-labs/core",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "cd ../.. && eslint packages/core/src packages/core/test",
    "test": "vitest run --coverage --coverage.include=src/state/** --coverage.reporter=text --coverage.thresholds.branches=100"
  },
  "dependencies": {
    "@envoi-labs/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3"
  }
}
